{
  "name": "jev-lifecycle",
  "version": "0.3.2",
  "private": true,
  "description": "The production lifecycle suite for Jev and compatible typed decision models.",
  "type": "module",
  "workspaces": ["packages/*"],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "demo:preflight": "npm run build && node examples/preflight-journey.mjs",
    "check": "npm run check --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "coverage": "npm run coverage --workspaces --if-present",
    "release:check": "npm run check && npm test && npm run coverage && npm run build && npm pack --workspaces --dry-run"
  },
  "engines": { "node": ">=22" },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^24.19.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
